generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LoginMethodType {
  email
  google
  apple

  @@map("login_method_type")
}

enum TokenPurpose {
  verify_email
  reset_password

  @@map("token_purpose")
}

enum ProfileStatus {
  draft
  published

  @@map("profile_status")
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  email_verified       Boolean       @default(false) @map("email_verified")
  name                 String?
  username             String?       @unique
  avatar_url           String?       @map("avatar_url")
  onboarding_completed Boolean       @default(false) @map("onboarding_completed")
  created_at           DateTime      @default(now()) @map("created_at")
  last_login_at        DateTime?     @map("last_login_at")
  deleted_at           DateTime?     @map("deleted_at")
  login_methods        LoginMethod[]
  sessions             Session[]
  email_tokens         EmailToken[]
  profile              Profile?
  roles                Role[]

  @@map("users")
}

model LoginMethod {
  id               String          @id @default(uuid())
  user_id          String          @map("user_id")
  user             User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type             LoginMethodType
  provider_user_id String?         @map("provider_user_id")
  password_hash    String?         @map("password_hash")
  created_at       DateTime        @default(now()) @map("created_at")

  @@unique([type, provider_user_id])
  @@map("login_methods")
}

model Session {
  id         String   @id
  user_id    String   @map("user_id")
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime @map("expires_at")
  user_agent String?  @map("user_agent")
  ip         String?  @map("ip")
  created_at DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model EmailToken {
  id         String       @id @default(uuid())
  user_id    String       @map("user_id")
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  purpose    TokenPurpose
  token_hash String       @map("token_hash")
  expires_at DateTime     @map("expires_at")
  used_at    DateTime?    @map("used_at")
  created_at DateTime     @default(now()) @map("created_at")

  @@index([token_hash])
  @@map("email_tokens")
}

model Profile {
  id           String        @id @default(uuid())
  user_id      String        @unique @map("user_id")
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  headline     String?       @map("headline")
  bio          String?       @map("bio")
  location     String?       @map("location")
  avatar_url   String?       @map("avatar_url")
  status       ProfileStatus @default(draft) @map("status")
  published_at DateTime?     @map("published_at")
  created_at   DateTime      @default(now()) @map("created_at")
  updated_at   DateTime      @updatedAt @map("updated_at")

  @@map("profiles")
}

model Role {
  id          String   @id @default(uuid())
  user_id     String   @map("user_id")
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title       String   @map("title")
  description String?  @map("description")
  position    Int      @default(0) @map("position")
  is_primary  Boolean  @default(false) @map("is_primary")
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")
  skills      Skill[]

  @@map("roles")
}

model Skill {
  id         String   @id @default(uuid())
  role_id    String   @map("role_id")
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  name       String   @map("name")
  position   Int      @default(0) @map("position")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@map("skills")
}
